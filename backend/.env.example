# ==============================================
# Tharwah Capital - Backend Environment
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================
NODE_ENV=production
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/tharwah"

# ---- JWT Secrets (64+ random chars each) ----
JWT_SECRET=<64-random-chars>
JWT_REFRESH_SECRET=<64-random-chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=tharwah-api
JWT_AUDIENCE=tharwah-web

# ---- CORS Allowed Origins ----
ALLOWED_ORIGINS=https://www.yourdomain.com,https://tharwah.vercel.app

# ---- App URLs ----
APP_URL=https://www.yourdomain.com
API_URL=https://api.yourdomain.com
SOCKET_URL=https://api.yourdomain.com

# ---- Super Admin Credentials ----
# Generate hash: npm run hash-password -- "YourStrongPassword"
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD_HASH=<bcrypt-hash>
SUPER_ADMIN_SALT=<bcrypt-salt>

# ---- SSL (VPS / Nginx) ----
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ---- Error Monitoring (optional) ----
SENTRY_DSN=

# ---- Security ----
SESSION_TIMEOUT_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- Logging ----
LOG_LEVEL=info
