# ==============================================
# Tharwah Capital - Backend Environment (Production)
# PostgreSQL on private VPS
# ==============================================
NODE_ENV=production
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/tharwah"

# ---- JWT Secrets (64+ random chars each) ----
JWT_SECRET=<64-random-chars>
JWT_REFRESH_SECRET=<64-random-chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=tharwah-api
JWT_AUDIENCE=tharwah-web

# ---- CORS Allowed Origins ----
# Frontend domain (Vercel)
ALLOWED_ORIGINS=https://www.yourdomain.com,https://tharwah.vercel.app

# ---- App URLs ----
APP_URL=https://www.yourdomain.com
API_URL=https://api.yourdomain.com
SOCKET_URL=https://api.yourdomain.com

# ---- Super Admin Credentials ----
# Generate hash: npm run hash-password -- "YourStrongPassword"
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD_HASH=<bcrypt-hash>

# ---- Security ----
SESSION_TIMEOUT_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- Live market data ----
# Provider endpoint must return an array or { data: [...] } with symbol, price, and change.
MARKET_DATA_URL=
MARKET_DATA_API_KEY=

# ---- Logging ----
LOG_LEVEL=info
