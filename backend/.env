# ==============================================
# Tharwah Capital - Backend Environment (Production)
# لا يحتوي أي قيمة صلبة — كل القيم من ENV فقط
# ==============================================
NODE_ENV=production
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/tharwah"

# ---- JWT Secrets (64+ random chars) ----
JWT_SECRET=<64-random-chars>
JWT_REFRESH_SECRET=<64-random-chars>
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS — مرن لأي دومين ----
# مثال: https://www.your-domain.com,https://tharwah.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://www.your-domain.com,https://tharwah.vercel.app

# ---- App URLs ----
APP_URL=https://www.your-domain.com
API_URL=https://api.your-domain.com
SOCKET_URL=https://api.your-domain.com

# ---- Admin Credentials (ENV فقط) ----
SUPER_ADMIN_EMAIL=admin@your-company.com
SUPER_ADMIN_PASSWORD_HASH=<generated-hash>
SUPER_ADMIN_SALT=<generated-salt>

# ---- Security ----
SESSION_TIMEOUT_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- SSL / Nginx ----
SSL_CERT_PATH=/etc/letsencrypt/live/api.your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/api.your-domain.com/privkey.pem

# ---- Monitoring (Optional) ----
SENTRY_DSN=
LOG_LEVEL=info
