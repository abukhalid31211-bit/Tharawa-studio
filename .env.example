# ==============================================
# Tharwah Capital - Environment Variables (Production-Ready)
# Backend + PostgreSQL on VPS — No Supabase
# ==============================================

# ---- Frontend URLs ----
VITE_APP_URL=https://www.yourdomain.com
VITE_API_URL=https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com

# ---- Session Security (client-side signature only) ----
VITE_SESSION_SECRET=<64-random-chars>

# ---- Optional Monitoring ----
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# ---- Development ----
DISABLE_HMR=false
