# ==============================================
# Tharwah Capital - Environment Variables (Production-Ready)
# لا يحتوي أي قيمة صلبة — كل القيم من المتغيرات البيئية فقط
# ==============================================

# ---- App URLs (مرن لأي دومين) ----
# لا تضع أي قيمة افتراضية صلبة — يجب تحديدها في Vercel Dashboard أو VPS
VITE_APP_URL=https://www.your-domain.com
VITE_API_URL=https://api.your-domain.com
VITE_SOCKET_URL=https://api.your-domain.com

# ---- Admin (من ENV فقط — لا هاردكود نهائياً) ----
VITE_SUPER_ADMIN_EMAIL=admin@your-company.com
VITE_SUPER_ADMIN_PASSWORD_HASH=<generated-hash>
VITE_SUPER_ADMIN_SALT=<generated-salt>

# ---- Session Security ----
VITE_SESSION_SECRET=<64-random-chars>

# ---- Socket Connection ----
VITE_SOCKET_PATH=/socket.io

# ---- Development ----
DISABLE_HMR=false
NODE_ENV=production
