# ==============================================
# Tharwah Capital - Environment Variables
# انسخ هذا الملف إلى .env.local واملأ القيم
# ==============================================

# ---- Supabase (Required for Production) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server only - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- App URLs ----
VITE_API_URL=/api/v1
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---- Admin (Required - No Hardcoded Fallback in Production) ----
# Super admin email - must be set via ENV
VITE_SUPER_ADMIN_EMAIL=admin@tharwah.com
# Generate hash using: npm run hash-password -- yourPassword
VITE_SUPER_ADMIN_PASSWORD_HASH=your-hashed-password
VITE_SUPER_ADMIN_SALT=your-salt

# ---- Session Security ----
VITE_SESSION_SECRET=change-this-to-random-64-char-string-in-production

# ---- Optional: Monitoring ----
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# ---- Optional: AI ----
GEMINI_API_KEY=your-gemini-key
VITE_GEMINI_API_KEY=your-gemini-key

# ---- Development ----
# Set to true to disable HMR in certain environments
DISABLE_HMR=false
